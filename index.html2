<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog Application</title>
    <link rel="stylesheet" href="style.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            background-color: #f4f4f9;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
        }
        .card {
            background: white;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        input, textarea, button {
            width: 100%;
            margin-top: 10px;
            padding: 10px;
            box-sizing: border-box;
            border-radius: 4px;
            border: 1px solid #ccc;
        }
        button {
            background-color: #007bff;
            color: white;
            border: none;
            cursor: pointer;
            font-weight: bold;
        }
        button:hover {
            background-color: #0056b3;
        }
        .btn-edit {
            background-color: #f0ad4e;
            width: auto;
            display: inline-block;
            margin-right: 5px;
        }
        .btn-edit:hover {
            background-color: #ec971f;
        }
        .btn-delete {
            background-color: #d9534f;
            width: auto;
            display: inline-block;
        }
        .btn-delete:hover {
            background-color: #c9302c;
        }
        .btn-details {
            background-color: #17a2b8;
            width: auto;
            display: inline-block;
            margin-right: 5px;
        }
        .btn-details:hover {
            background-color: #138496;
        }
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
        }
        .modal-content {
            background: white;
            padding: 20px;
            border-radius: 8px;
            max-width: 500px;
            width: 100%;
        }
        .success-text {
            color: green;
            margin-top: 10px;
            display: none;
        }
    </style>
</head>
<body>

<div class="container">
    <!-- User Registration Section -->
    <div class="card">
        <h2>User Registration</h2>
        <form id="registerForm">
            <input type="text" id="regUsername" placeholder="Username" required>
            <input type="email" id="regEmail" placeholder="Email" required>
            <input type="password" id="regPassword" placeholder="Password" required>
            <button type="submit">Register</button>
        </form>
        <p id="regSuccess" class="success-text">Registration successful!</p>
    </div>

    <!-- Create New Blog Section -->
    <div class="card">
        <h2>Create New Blog</h2>
        <form id="blogForm">
            <input type="text" id="blogTitle" placeholder="Blog Title" required>
            <input type="text" id="blogAuthor" placeholder="Author Name">
            <textarea id="blogContent" placeholder="Write your blog content..." rows="4" required></textarea>
            <button type="submit">Create Blog</button>
        </form>
        <p id="blogSuccess" class="success-text">Blog created successfully!</p>
    </div>

    <!-- All Blog Posts Display -->
    <div class="card">
        <h2>All Blog Posts</h2>
        <button id="refreshBtn" style="margin-bottom: 15px;">Refresh Blogs</button>
        <div id="blogList"></div>
    </div>
</div>

<!-- Blog Details Modal -->
<div id="blogDetailsModal" class="modal">
    <div class="modal-content">
        <h2>Blog Details</h2>
        <h3 id="modalTitle"></h3>
        <p id="modalContent"></p>
        <p><strong>Author:</strong> <span id="modalAuthor"></span></p>
        <p><small><strong>Created:</strong> <span id="modalDate"></span></small></p>
        <button onclick="closeDetails()" style="background-color: #6c757d;">Close</button>
    </div>
</div>

<script>
    const API_URL = "http://localhost:5000/api/posts";

    // Initialize Event Listeners
    document.getElementById("registerForm").addEventListener("submit", handleRegister);
    document.getElementById("blogForm").addEventListener("submit", handleCreateBlog);
    document.getElementById("refreshBtn").addEventListener("click", fetchBlogs);

    // Initial Fetch
    fetchBlogs();

    // 1. REGISTER USER HANDLER
    function handleRegister(e) {
        e.preventDefault();
        document.getElementById("regSuccess").style.display = "block";
        document.getElementById("registerForm").reset();
        setTimeout(() => {
            document.getElementById("regSuccess").style.display = "none";
        }, 3000);
    }

    // 2. CREATE BLOG HANDLER (POST)
    async function handleCreateBlog(e) {
        e.preventDefault();
        const title = document.getElementById("blogTitle").value;
        const author = document.getElementById("blogAuthor").value || "Anonymous";
        const content = document.getElementById("blogContent").value;

        try {
            const response = await fetch(API_URL, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ title, author, content })
            });

            if (response.ok) {
                document.getElementById("blogSuccess").style.display = "block";
                document.getElementById("blogForm").reset();
                fetchBlogs();
                setTimeout(() => {
                    document.getElementById("blogSuccess").style.display = "none";
                }, 3000);
            }
        } catch (error) {
            console.error("Error creating blog:", error);
        }
    }

    // 3. READ ALL BLOGS HANDLER (GET)
    async function fetchBlogs() {
        try {
            const response = await fetch(API_URL);
            const posts = await response.json();
            const blogList = document.getElementById("blogList");
            blogList.innerHTML = "";

            if (posts.length === 0) {
                blogList.innerHTML = "<p>No blogs found.</p>";
                return;
            }

            posts.forEach(post => {
                const card = document.createElement("div");
                card.style = "border: 1px solid #ddd; padding: 15px; margin-bottom: 10px; border-radius: 6px;";
                card.innerHTML = `
                    <h3>${escapeHTML(post.title)}</h3>
                    <p>${escapeHTML(post.content.substring(0, 100))}${post.content.length > 100 ? "..." : ""}</p>
                    <p><strong>Author:</strong> ${escapeHTML(post.author || "Anonymous")}</p>
                    <div style="margin-top: 10px;">
                        <button class="btn-details" onclick="showDetails('${post._id}')">View Details</button>
                        <button class="btn-edit" onclick="editBlog('${post._id}', '${escapeHTML(post.title)}', '${escapeHTML(post.content)}', '${escapeHTML(post.author)}')">Edit</button>
                        <button class="btn-delete" onclick="deleteBlog('${post._id}')">Delete</button>
                    </div>
                `;
                blogList.appendChild(card);
            });
        } catch (error) {
            console.error("Error fetching blogs:", error);
        }
    }

    // 4. READ SINGLE BLOG DETAILS
    async function showDetails(id) {
        try {
            const response = await fetch(`${API_URL}/${id}`);
            const post = await response.json();

            document.getElementById("modalTitle").textContent = post.title;
            document.getElementById("modalContent").textContent = post.content;
            document.getElementById("modalAuthor").textContent = post.author || "Anonymous";
            document.getElementById("modalDate").textContent = new Date(post.createdAt).toLocaleString();
            
            document.getElementById("blogDetailsModal").style.display = "flex";
        } catch (error) {
            console.error("Error fetching details:", error);
        }
    }

    function closeDetails() {
        document.getElementById("blogDetailsModal").style.display = "none";
    }

    // 5. UPDATE BLOG HANDLER (PUT)
    async function editBlog(id, currentTitle, currentContent, currentAuthor) {
        const newTitle = prompt("Edit Blog Title:", currentTitle);
        const newContent = prompt("Edit Blog Content:", currentContent);
        const newAuthor = prompt("Edit Author:", currentAuthor);

        if (!newTitle || !newContent) return;

        try {
            const response = await fetch(`${API_URL}/${id}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ title: newTitle, content: newContent, author: newAuthor })
            });

            if (response.ok) {
                alert("Blog updated successfully!");
                fetchBlogs();
            }
        } catch (error) {
            console.error("Error updating blog:", error);
        }
    }

    // 6. DELETE BLOG HANDLER (DELETE)
    async function deleteBlog(id) {
        if (confirm("Are you sure you want to delete this blog?")) {
            try {
                const response = await fetch(`${API_URL}/${id}`, {
                    method: "DELETE"
                });

                if (response.ok) {
                    alert("Blog deleted successfully!");
                    fetchBlogs();
                }
            } catch (error) {
                console.error("Error deleting blog:", error);
            }
        }
    }

    // =========================================================
    // SECURITY HELPER
    // =========================================================
    function escapeHTML(text) {
        const div = document.createElement("div");
        div.textContent = text || "";
        return div.innerHTML;
    }
</script>

</body>
</html>
